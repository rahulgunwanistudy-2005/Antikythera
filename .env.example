# Local files only; never commit populated secrets.
ANTIKYTHERA_REVIEW_ENABLED=1
# Optional NCBI bulk retrieval contact and key.
NCBI_EMAIL=
NCBI_API_KEY=
# Optional model adapter. Explicit CLI --model required for paid remote calls.
ANTIKYTHERA_MODEL_PROTOCOL=gateway
# For local Ollama use protocol=ollama and endpoint=http://127.0.0.1:11434/api/chat
ANTIKYTHERA_MODEL_ENDPOINT=
ANTIKYTHERA_MODEL_NAME=
ANTIKYTHERA_MODEL_TOKEN=
